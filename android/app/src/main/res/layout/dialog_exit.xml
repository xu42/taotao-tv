<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
    </data>

    <!-- 退出 / 操作对话框 - 左侧提示 + 右侧操作区（约 1/3 屏宽） -->
    <LinearLayout
        android:id="@+id/exitDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants">

        <!-- 左侧提示区域，点击关闭对话框 -->
        <LinearLayout
            android:id="@+id/dialogBackdrop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#80000000"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:id="@+id/exitTipTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="遥控器操作提示"
                android:textColor="#FFB37A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exitTipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="上下左右：快速切台 / 移动焦点\n设置键：打开频道菜单（可切换源）\n数字键：跳转收藏栏对应序号"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 右侧对话框内容（约 1/3 屏宽） -->
        <LinearLayout
            android:id="@+id/exitDialogContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E6000000"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants">

            <!-- 画质列表（页面提供画质时才会出现） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hzListInExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:overScrollMode="never" />

            <Button
                android:id="@+id/btnFavorite"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/menu_button_background"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="收藏当前频道"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:nextFocusDown="@id/btnBackHome"
                android:nextFocusUp="@id/btnCancel" />

            <Button
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/menu_button_background"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="返回首页"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:nextFocusDown="@id/btnExitApp"
                android:nextFocusUp="@id/btnFavorite" />

            <Button
                android:id="@+id/btnExitApp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/menu_button_background"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="退出应用"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:nextFocusDown="@id/btnCancel"
                android:nextFocusUp="@id/btnBackHome" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/menu_button_background"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="取消"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:nextFocusDown="@id/btnFavorite"
                android:nextFocusUp="@id/btnExitApp" />
        </LinearLayout>
    </LinearLayout>
</layout>
