<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <!--
        操作面板：垂直水平居中，风格参考 Netflix 电视端 —— 近黑圆角卡片，
        焦点落到的按钮反白（白底黑字）。
        电视端按「返回」键弹出（1.2 秒内连按两次直接退出应用）；
        平板点右半屏也会弹出。
    -->
    <FrameLayout
        android:id="@+id/exitDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A6000000"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/exitDialogCard"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dialog_card_bg"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingLeft="34dp"
            android:paddingRight="34dp"
            android:paddingTop="30dp"
            android:paddingBottom="24dp">

            <!-- 当前频道 -->
            <TextView
                android:id="@+id/exitChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="CCTV-13 新闻" />

            <TextView
                android:id="@+id/exitSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="#8A8A8A"
                android:textSize="14sp"
                tools:text="央视 · 央视网 · 共 2 个源" />

            <!-- 画质：网页侧提供了才显示 -->
            <TextView
                android:id="@+id/hzLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="画质"
                android:textColor="#8A8A8A"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hzListInExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:overScrollMode="never"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnFavorite"
                style="@style/DialogActionButton"
                android:layout_marginTop="24dp"
                android:nextFocusDown="@id/btnExitApp"
                android:nextFocusUp="@id/btnClose"
                android:text="收藏当前频道" />

            <Button
                android:id="@+id/btnExitApp"
                style="@style/DialogActionButton"
                android:nextFocusDown="@id/btnClose"
                android:nextFocusUp="@id/btnFavorite"
                android:text="退出应用" />

            <Button
                android:id="@+id/btnClose"
                style="@style/DialogActionButton"
                android:nextFocusDown="@id/btnFavorite"
                android:nextFocusUp="@id/btnExitApp"
                android:text="关闭" />

            <TextView
                android:id="@+id/exitHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="连按两次「返回」键可直接退出\n数字键可跳转收藏频道"
                android:textColor="#6B6B6B"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</layout>
