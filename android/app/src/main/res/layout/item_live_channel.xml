<?xml version="1.0" encoding="utf-8"?>
<!-- 切台菜单右栏：一个频道（前面的 ▶ 表示正在播放，右侧心形表示已收藏） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="10dp"
    android:paddingRight="16dp">

    <TextView
        android:id="@+id/chMarker"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:text="▶"
        android:textColor="#FF8A3D"
        android:textSize="14sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/chName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#EDF0F5"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/chSources"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:textColor="#9AA3B2"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chHeart"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:gravity="right"
        android:text="♡"
        android:textColor="#668C94A3"
        android:textSize="18sp" />
</LinearLayout>
