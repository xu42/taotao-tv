<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="live"
            type="com.xu42.tv.live.domain.live.Live" />
    </data>

    <FrameLayout
        android:id="@+id/liveWebViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/darker_gray">
        <LinearLayout
            android:id="@+id/webviewWrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E3EDCD"
            android:gravity="center"
            android:focusable="true"
            android:visibility="visible"
            android:orientation="vertical">
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E3EDCD"
            android:focusable="true"
            android:gravity="center"
            android:visibility="gone"
            android:orientation="vertical">
        </LinearLayout>
        <LinearLayout
            android:id="@+id/notify"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:focusable="false"
            android:visibility="visible"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/liveName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/fontBig"
                    android:textColor="@color/white"
                     />
            </LinearLayout>

        </LinearLayout>
        <!-- 频道加载中：全屏遮罩，避免加载期间露出原始网页内容 -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/live_loading_bg"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <!-- 跳动的圆点由代码动态生成 -->
                <LinearLayout
                    android:id="@+id/loadingDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/loadingName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="正在加载频道…"
                    android:textColor="#C9CFDA"
                    android:textSize="18sp" />
            </LinearLayout>
        </FrameLayout>

        <!--
            切台菜单：整块只占屏幕左半边（左栏分类 / 右栏频道），右半边完全留白 ——
            直播画面照常可见，点右半屏空白处即收起菜单。
            遥控器：左右在两栏之间移动，上下在本栏内移动，OK 播放并收起菜单。
        -->
        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">

            <!--
                左半边：菜单本体（clickable 只为了吃掉空白处的点击，别让它穿到下面的播放器）
                底色不画在这一层：两栏各自半透明，直播画面能透出来，前后层次也更清楚
            -->
            <LinearLayout
                android:id="@+id/menuPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="false"
                android:orientation="horizontal">

                <!-- 左栏：分类（80% 深底，作为导航骨架最实） -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.52"
                    android:orientation="vertical"
                    android:background="#CC070A10"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="10dp"
                        android:text="频道分类"
                        android:textColor="#7F8798"
                        android:textSize="14sp" />

                    <ListView
                        android:id="@+id/categoryList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:listSelector="@drawable/live_menu_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:descendantFocusability="afterDescendants" />
                </LinearLayout>

                <!-- 右栏：该分类下的频道（72% 更透，频道多、停留久，画面透出来更耐看） -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#B8070A10"
                    android:paddingTop="24dp"
                    android:paddingBottom="16dp"
                    android:paddingLeft="20dp"
                    android:paddingRight="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/categoryTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textSize="22sp"
                            tools:text="央视" />

                        <TextView
                            android:id="@+id/categoryCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:textColor="#9AA3B2"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textSize="14sp"
                            tools:text="19 个频道" />

                        <TextView
                            android:id="@+id/sourceHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#FF8A3D"
                            android:shadowColor="#CC000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textSize="15sp"
                            tools:text="央视网 · 2 个源" />
                    </LinearLayout>

                    <ListView
                        android:id="@+id/channelList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:divider="@null"
                        android:dividerHeight="0dp"
                        android:listSelector="@drawable/live_menu_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:descendantFocusability="afterDescendants" />

                    <TextView
                        android:id="@+id/menuHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="▲▼ 选择   ◀▶ 切栏   OK 播放\n设置键 收藏   播放中 ◀▶ 换源"
                        android:textColor="#8A93A6"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右半边：留白，点一下收起菜单 -->
            <View
                android:id="@+id/menuBlank"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="false" />
        </LinearLayout>

        <!-- 操作 / 设置面板 -->
        <include
            android:id="@+id/exitDialog"
            layout="@layout/dialog_exit" />
    </FrameLayout>
</layout>
